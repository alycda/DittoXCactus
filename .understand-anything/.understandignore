# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
#
# Built-in defaults (always excluded): node_modules/, .git/, dist/, build/,
# obj/, *.lock, *.min.js, *.map, etc.

# --- Flutter toolchain + build output ---
.dart_tool/
.flutter-plugins-dependencies
.flutter-plugins
.metadata
.packages
*.iml
ios/Flutter/ephemeral/
ios/Pods/
ios/Podfile.lock
android/.gradle/
android/app/build/
android/local.properties
android/gradle/
**/Generated.xcconfig
**/GeneratedPluginRegistrant.*

# --- Bulk research / build artifacts per CLAUDE.md ---
# 281-source research index per-source files (gitignored bulk)
_docs/research/index/_per_source/
# C4 dashboard build output (regenerated by `just c4-build`)
docs/c4/dashboard/
# locally-cloned papers/repos referenced by the index (gitignored)
_inspiration/
# captured demo artifacts
slides/media/
# per-run holdout evidence (gitignored per .gitignore in each subdir)
tools/holdout_34/runs/
tools/holdout_7/witness/

# --- Holdout determinism baselines (data only, not code) ---
tools/determinism_harness/baselines/
tools/determinism_harness/fixtures/

# --- Editor / OS noise ---
.DS_Store
.localized
.claude/*.local.json
.claude/workers/
.idea/

# --- Env + secrets ---
.env
.env.*
!.env.example

